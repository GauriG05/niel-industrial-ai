# NIEL Industrial Intelligence AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual values.
# NEVER commit the actual '.env' file to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# Security & Secret Cryptography
# IMPORTANT: In production, SECRET_KEY and ADMIN_API_KEY must be >= 32 characters of high-entropy randomness
SECRET_KEY=generate-at-least-32-characters-random-secret-key-for-session-tokens
ADMIN_API_KEY=generate-at-least-32-characters-secure-random-admin-api-key
SESSION_TOKEN_EXPIRE_SECONDS=86400
KILL_SWITCH_ENABLED=false

# OpenAI API Configuration (Backend-Only Secret)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database & Cache Persistence
# For SQLite: sqlite:///data/niel_sessions.db
# For PostgreSQL: postgresql://niel_user:your_password@localhost:5432/niel_db
DATABASE_URL=sqlite:///data/niel_sessions.db
# Redis for distributed rate limiting and state coordination (optional; in-memory fallback active if omitted)
REDIS_URL=redis://:redis_secure_pass@localhost:6379/0

# Docker Compose Credentials
POSTGRES_DB=niel_db
POSTGRES_USER=niel_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PASSWORD=your_secure_redis_password_here

# WebSocket & Connection Limits
WS_MAX_CONNECTIONS_PER_SESSION=5
WS_MAX_MESSAGES_PER_MINUTE=20

# Data Storage Paths (relative to backend or absolute)
DATA_DIR=../data
INDEX_DIR=../data/index
DOCS_DIR=../data/docs

# Rate Limiting & Usage Controls
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_SIZE_MB=15
MAX_RETRIEVAL_CHUNKS=5
SIMILARITY_SCORE_THRESHOLD=0.35

# CORS Allowed Origins (Comma-separated)
# For local development: ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ALLOWED_ORIGINS=https://newindiaelectricals.com,https://www.newindiaelectricals.com,http://localhost:5173
