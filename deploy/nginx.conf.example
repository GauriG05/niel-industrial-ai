# =============================================================================
# Nginx Reverse-Proxy Configuration Example for NIEL Industrial Intelligence AI
#
# Production Subdomain: assistant.newindiaelectricals.com -> 127.0.0.1:8000
#
# HTTPS Setup:
#   1. Copy this file to: /etc/nginx/sites-available/assistant.newindiaelectricals.com
#   2. Symlink: sudo ln -s /etc/nginx/sites-available/assistant.newindiaelectricals.com /etc/nginx/sites-enabled/
#   3. Test configuration: sudo nginx -t
#   4. Reload nginx: sudo systemctl reload nginx
#   5. Provision free Let's Encrypt SSL with Certbot:
#        sudo certbot --nginx -d assistant.newindiaelectricals.com
#      Certbot will automatically inject SSL certificates and 301 redirects for HTTPS.
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name assistant.newindiaelectricals.com;

    # Upload limit matching backend MAX_UPLOAD_SIZE_MB (15MB + margin)
    client_max_body_size 25M;

    # Enable compression for faster widget delivery
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket upgrade headers for /ws/chat/{session_id}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard client identity & forwarding headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keepalive timeouts for persistent realtime chat
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

